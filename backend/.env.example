# ============================================================
# NIRVIK Backend — Environment Variables
# Copy to .env and fill in values for local development
# NEVER commit .env to git
# ============================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
APP_TITLE=NIRVIK Intelligence Platform
APP_VERSION=0.1.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MongoDB ---
MONGODB_URI=mongodb://nirvik_user:nirvik_pass@localhost:27017/nirvik?authSource=nirvik
MONGODB_DATABASE=nirvik

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nirvik_neo4j_pass
NEO4J_DATABASE=neo4j

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO / Object Storage ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nirvik-evidence
MINIO_SECURE=false

# --- Hyperledger Fabric ---
# FABRIC_MODE: mock | real | unavailable
FABRIC_MODE=mock
FABRIC_PEER_ENDPOINT=
FABRIC_TLS_CERT_PATH=
FABRIC_CHANNEL_NAME=nirvik-channel
FABRIC_CHAINCODE_NAME=nirvik-evidence

# --- LLM / AI Assistant ---
# LLM_PROVIDER: openai | gemini | local | mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- NLP Model ---
SPACY_MODEL=en_core_web_sm
# Set to false in resource-constrained environments
NLP_USE_TRANSFORMERS=false
# Disable transformers silently if unavailable
NLP_TRANSFORMER_FALLBACK=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
